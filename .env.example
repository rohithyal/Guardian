# ─────────────────────────────────────────────────────────────────────
# Guardian S-SDLC — Environment Configuration
# Copy this file to .env and populate with your credentials.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────

# ── Gemini / Google AI ────────────────────────────────────────────
# Required: Get your key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Override the default Gemini model
GEMINI_MODEL=gemini-1.5-pro

# ── LLM Tuning ───────────────────────────────────────────────────
# Lower = more deterministic security analysis (recommended: 0.1–0.3)
TEMPERATURE=0.2
MAX_TOKENS=8192

# ── Logging ──────────────────────────────────────────────────────
# Set to DEBUG for verbose MCP transport logs, INFO for normal operation
LOG_LEVEL=INFO

# ── OSV API ──────────────────────────────────────────────────────
# Set to true to query osv.dev in real time instead of the offline mock DB.
# Falls back to mock automatically on network errors.
# GUARDIAN_LIVE_OSV=true
